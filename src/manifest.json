{
  "manifest_version": 3,
  "name": "Space Launcher",
  "version": "1.0.0",
  "description": "A keyboard-driven list of your links on every new tab, over a different James Webb Space Telescope photo each time.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "commands": {
    "go-home": {
      "suggested_key": {
        "mac": "MacCtrl+L"
      },
      "description": "Open Space Launcher in this tab"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "claude.js"
      ],
      "run_at": "document_start"
    }
  ]
}
