{
  "manifest_version": 3,
  "name": "Homepage Links",
  "version": "0.1.0",
  "description": "Replaces the new tab page.",
  "key": "",
  "permissions": [
    "storage",
    "tabs"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
